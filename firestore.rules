rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mailroom Rush global leaderboard: anyone can read; new scores must be well-formed.
    match /mailroom_rush_scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'mode', 'correct', 'accuracy', 'bestStreak', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 16
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 50000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    // Everything else stays locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
